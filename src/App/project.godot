; Engine configuration file.
config_version=5

[application]

config/name="Kriegsspiel Table"
config/version="0.9.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.06, 0.065, 0.07, 1)
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

LockHarness="*res://dev/LockHarness.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="KriegsspielTable"
project/solution_directory="../.."

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4

[shader_globals]

ground_style={
"type": "int",
"value": 0
}
contour_interval={
"type": "float",
"value": 0.0
}
units_per_metre={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 0.0
}

[steam]

app_id=0
