; Engine configuration file.
config_version=5

[application]

config/name="Kriegsspiel Table"
config/version="0.9.90"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/show_image=true
boot_splash/image="res://brand/splash.png"
boot_splash/stretch_mode=0
boot_splash/bg_color=Color(0.06, 0.065, 0.07, 1)
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/project_settings_override="user://graphics.cfg"

[autoload]

LockHarness="*res://dev/LockHarness.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="KriegsspielTable"
project/solution_directory="../.."

[gui]

common/swap_cancel_ok=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

limits/cluster_builder/max_clustered_elements=8192
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
rendering_device/d3d12/max_resource_descriptors=1000000

[shader_globals]

ground_style={
"type": "int",
"value": 0
}
contour_interval={
"type": "float",
"value": 0.0
}
units_per_metre={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 0.0
}
ground_gain={
"type": "vec3",
"value": Vector3(0.69, 0.69, 0.69)
}
heights_view={
"type": "float",
"value": 0.0
}
ground_relaxed={
"type": "float",
"value": 0.0
}
ground_eye={
"type": "float",
"value": 0.0
}
ground_bare_m={
"type": "float",
"value": 0.0
}
ground_world={
"type": "float",
"value": 0.0
}
sun_glint={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
cloud_shade={
"type": "float",
"value": 0.0
}
cloud_scale={
"type": "float",
"value": 0.0
}
cloud_drift={
"type": "vec2",
"value": Vector2(0, 0)
}
atlas_slots={
"type": "float",
"value": 16.0
}
ground_relief={
"type": "float",
"value": 0.0
}
grid_kind={
"type": "int",
"value": 0
}
grid_pitch={
"type": "float",
"value": 10.0
}
grid_divisions={
"type": "int",
"value": 1
}
grid_hex_flat={
"type": "int",
"value": 0
}
grid_ink={
"type": "vec4",
"value": Vector4(0.1, 0.1, 0.125, 0.5)
}
table_shift={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

[steam]

app_id=0
