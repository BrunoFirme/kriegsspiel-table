<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KTable.Converter</RootNamespace>
    <AssemblyName>Converter</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <ProjectReference Include="../../src/Server/Server.csproj" />
    <ProjectReference Include="../../src/Client/Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="converter.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../surface/ledger.json" Link="surface/ledger.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/App/standard/std.dice/pack.json" LogicalName="std.dice/pack.json" />
    <EmbeddedResource Include="../../src/App/standard/std.dice/assets/*.obj" LogicalName="std.dice/assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Dice/*.*" LogicalName="dice/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.3" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
  <Target Name="DropSkiaSymbols" AfterTargets="Build;Publish">
    <Delete Files="$(OutDir)libSkiaSharp.pdb;$(PublishDir)libSkiaSharp.pdb" ContinueOnError="true" />
  </Target>
</Project>
